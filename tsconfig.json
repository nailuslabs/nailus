{
  "compilerOptions": {
    "target": "es2022",
    "jsx": "preserve",
    "lib": [
      "es2022", 
      "esnext.disposable", 
      "dom",
      "esnext"
    ],

    "rootDir": ".",
    "module": "esnext",
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["./src", "./test", "./test-dts", "./example"],
  "exclude": ["./test/assets", "./test/helpers", "dist"]
}
