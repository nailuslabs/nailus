{
  "name": "@nailus/webpack",
  "type": "module",
  "version": "1.0.1",
  "description": "The Webpack plugin pour nailus",
  "author": {
    "name": "Naïloth Esdras NSOUNDA NSILULU",
    "email": "nailuslab@gmail.com"
  },
  "homepage": "https://github.com/nailuslabs/nailus/tree/main#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nailuslabs/nailus.git#main",
    "directory": "packages-engine/autocomplete"
  },
  "bugs": {
    "url": "https://github.com/nailuslabs/nailus/issues"
  },
  "keywords": [
    "nailus",
    "webpack-plugin"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./rspack": {
      "import": "./dist/rspack.mjs",
      "require": "./dist/rspack.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.cts",
        "./*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config-loader unrun",
    "dev": "tsup --config-loader unrun --watch"
  },
  "peerDependencies": {
    "webpack": "^5"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "chokidar": "^5.0.0",
    "magic-string": "^0.30.21",
    "pathe": "^2.0.3",
    "tinyglobby": "^0.2.17",
    "unplugin": "^3.3.0",
    "unplugin-utils": "^0.3.2",
    "webpack-sources": "^3.5.0"
  },
  "devDependencies": {
    "webpack": "^5.108.3"
  }
}
